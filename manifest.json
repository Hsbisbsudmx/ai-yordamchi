{
  "manifest_version": 3,
  "name": "AI Yordamchi",
  "version": "1.0",
  "description": "Har qanday saytda AI yordamchi",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
